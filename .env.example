# Base URL of the Rajdhani API, including the version segment.
# Only VITE_-prefixed values reach the browser bundle — never put a secret here.
#
# If your host cannot set a VITE_ name, vite.config.js also accepts
# VITE_API_BASE_URL, API_BASE_URL or BASE_URL and maps whichever it finds.
# (BASE_URL is safe as a *host* variable; it is only reserved on the client,
# where Vite defines import.meta.env.BASE_URL as the app's public base path.)
VITE_BASE_URL=https://api.rajdhanifood.com/api/v1

# Public customer site, used by the "View on site" links.
# Also accepted: SITE_URL
VITE_SITE_URL=https://rajdhanifood.com
